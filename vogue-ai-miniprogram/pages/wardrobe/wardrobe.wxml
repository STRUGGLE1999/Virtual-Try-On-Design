<view class="container">
  <view class="section-space">
    <view class="flex items-center justify-between mb-4">
      <text class="text-xs font-bold text-stone-500 uppercase tracking-widest">{{wardrobeItems.length}} 件入库单品 · {{pendingQueue.length}} 件待识别</text>
    </view>
    
    <view class="search-bar">
      <text style="font-size: 20px;" class="mr-2">🔍</text>
      <input type="text" placeholder="搜索衣物名称，如：白衬衫" value="{{searchQuery}}" bindinput="onSearchInput" class="search-input" />
    </view>
  </view>

  <view wx:if="{{pendingQueue.length > 0}}" class="section-space">
    <view class="flex items-end justify-between mb-4">
      <text class="text-lg text-serif font-bold text-stone-900">AI 识别队列</text>
      <text class="text-xs font-bold text-stone-400 tracking-wider">{{pendingQueue.length}} 件待处理</text>
    </view>

    <scroll-view scroll-x class="queue-scroll">
      <view class="queue-container">
        <view wx:for="{{pendingQueue}}" wx:key="id" wx:for-item="item" class="queue-item {{item.id === selectedQueueId ? 'queue-item-selected' : ''}}" bindtap="selectQueueItem" data-id="{{item.id}}">
          <image src="{{item.imageUrl}}" mode="aspectFill" class="queue-image"></image>
          <view wx:if="{{item.id === selectedQueueId}}" class="queue-selected-overlay">
            <text style="font-size: 20px;">✓</text>
            <text class="text-xs font-bold bg-white text-stone-900 px-2 py-0.5 rounded-full shadow">确认中</text>
          </view>
          <view wx:else class="queue-hover-overlay">
            <text style="font-size: 20px;">✨</text>
          </view>
        </view>

        <view class="queue-add-item" bindtap="onAddQueueItem">
          <text style="font-size: 24px;" class="mb-1">+</text>
          <text class="text-xs font-bold uppercase tracking-widest">添加单品</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:else class="card text-center text-stone-400 py-12 mb-4">
    <text style="font-size: 32px;" class="mb-2">✨</text>
    <text class="text-xs font-bold uppercase tracking-wider block">AI 待识别队列已放空</text>
    <text class="text-xs text-stone-400 mt-1">所有上传单品都已妥善整理入库</text>
  </view>

  <view wx:if="{{selectedQueueItem}}" class="section-space">
    <view wx:if="{{scannedNotify}}" class="p-3.5 bg-green-50 border border-green-100 text-green-700 rounded-2xl text-xs font-medium mb-3 animate-bounce">
      {{scannedNotify}}
    </view>

    <button class="w-full py-4 bg-blue-600 text-white rounded-2xl font-bold text-xs uppercase tracking-widest flex items-center justify-center gap-2 {{isClassifying ? 'opacity-70' : ''}}" bindtap="onAIScan" disabled="{{isClassifying}}">
      <text style="font-size: 16px;">✨</text>
      <text>{{isClassifying ? 'AI 模型正在提取织物特征...' : 'AI 极致重新识别'}}</text>
    </button>

    <view class="card mt-3">
      <view class="flex justify-between items-start mb-5">
        <view>
          <text class="text-xs uppercase font-bold tracking-widest text-stone-400">AI 识别结果</text>
          <text class="text-xl text-serif font-bold text-stone-900 mt-0.5 block">{{selectedQueueItem.name}}</text>
        </view>
        <text class="bg-emerald-50 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">98% 匹配</text>
      </view>

      <view class="grid grid-cols-2 gap-4 mb-6 pb-5 border-b border-stone-100">
        <view>
          <text class="text-xs uppercase font-bold tracking-widest text-stone-500">品类</text>
          <text class="font-bold text-stone-800 block mt-1">{{selectedQueueItem.categoryLabel}}</text>
        </view>
        
        <view>
          <text class="text-xs uppercase font-bold tracking-widest text-stone-500">颜色</text>
          <view class="flex items-center gap-1.5 mt-1">
            <view class="w-3.5 h-3.5 rounded-full border border-stone-300 shadow-sm" style="background-color: {{selectedQueueItem.colorHex}}"></view>
            <text class="font-bold text-stone-800">{{selectedQueueItem.colorName}}</text>
          </view>
        </view>

        <view>
          <text class="text-xs uppercase font-bold tracking-widest text-stone-500">材质</text>
          <text class="font-bold text-stone-800 block mt-1">{{selectedQueueItem.material}}</text>
        </view>

        <view>
          <text class="text-xs uppercase font-bold tracking-widest text-stone-500">季节匹配</text>
          <text class="font-bold text-stone-800 block mt-1">{{selectedQueueItem.season}}</text>
        </view>

        <view class="col-span-2">
          <text class="text-xs uppercase font-bold tracking-widest text-stone-500">服装标签</text>
          <view class="flex flex-wrap gap-1.5 mt-2">
            <text wx:for="{{selectedQueueItem.tags}}" wx:key="index" class="bg-stone-50 border border-stone-100 px-2.5 py-0.5 rounded-full text-xs font-bold text-stone-600">{{item}}</text>
          </view>
        </view>

        <view class="col-span-2 pt-4 border-t border-stone-100">
          <text class="text-xs uppercase font-bold tracking-widest text-blue-600">AI 推荐理由</text>
          <text class="text-xs text-stone-600 leading-relaxed italic font-serif bg-stone-50/50 p-3 rounded-xl border border-stone-100 block mt-2">"这款【{{selectedQueueItem.brand}}】的特质面料编织精湛，是不可多得的胶囊基础。配合林夏现有的深色直筒系列西装，能大幅拓宽日常休闲的层次宽度。"</text>
        </view>
      </view>

      <button class="w-full py-4 bg-stone-900 border border-stone-800 text-white font-bold text-xs uppercase tracking-widest rounded-2xl" bindtap="onDeposit">
        确认单品安全入库
      </button>
    </view>
  </view>

  <view class="section-space">
    <scroll-view scroll-x class="filter-scroll mb-4">
      <view class="filter-container">
        <view wx:for="{{filterTabs}}" wx:key="key" class="filter-tab {{selectedFilter === item.key ? 'filter-tab-active' : ''}}" bindtap="onFilterChange" data-filter="{{item.key}}">
          <text>{{item.label}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="flex items-center justify-between mb-4">
      <text class="text-xl text-serif font-bold text-stone-900">已入库单品</text>
      <text style="font-size: 16px;">⚙️</text>
    </view>

    <view wx:if="{{filteredItems.length > 0}}" class="items-grid">
      <view wx:for="{{filteredItems}}" wx:key="id" wx:for-item="item" class="item-card" bindtap="showItemDetail" data-item="{{item}}">
        <view class="item-image-wrap">
          <image src="{{item.imageUrl}}" mode="aspectFill" class="item-image"></image>
          <view class="item-tag">
            <text>{{item.material.split(' ').pop()}}</text>
          </view>
        </view>
        <text class="text-xs uppercase font-bold tracking-widest text-stone-500 px-1 truncate">{{item.brand}}</text>
        <text class="text-xs font-semibold text-stone-800 px-1 truncate block">{{item.name}}</text>
      </view>
    </view>

    <view wx:else class="card text-center text-stone-400 py-12">
      <text class="text-xs font-bold uppercase tracking-wider block">未找到筛选的单品</text>
      <text class="text-xs text-stone-300 mt-1">请输入其他搜索字符或调整类别筛选</text>
    </view>
  </view>
</view>
