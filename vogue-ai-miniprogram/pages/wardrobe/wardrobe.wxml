<view class="container animate-fadeIn">
  <view class="flex justify-between items-center mb-6">
    <view>
      <text class="text-xs uppercase font-bold tracking-widest text-stone-400">我的衣橱</text>
      <text class="text-2xl text-serif font-bold text-stone-900 mt-1">我的收藏</text>
    </view>
    <button class="w-10 h-10 bg-white border border-stone-200 rounded-full flex items-center justify-center" bindtap="onOpenSearch">
      <text class="text-lg">🔍</text>
    </button>
  </view>

  <scroll-view class="flex gap-3 mb-6 overflow-x-auto scrollbar-hide" scroll-x="true">
    <view 
      wx:for="{{categories}}" 
      wx:key="id"
      class="shrink-0 px-5 py-2 rounded-full border text-xs font-bold cursor-pointer transition-all {{activeCategory === item.id ? 'bg-stone-900 text-white border-stone-900' : 'bg-white text-stone-600 border-stone-200'}}"
      bindtap="onSelectCategory"
      data-id="{{item.id}}"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <view wx:if="{{filteredItems.length === 0}}" class="flex flex-col items-center justify-center py-16 text-center">
    <view class="text-6xl mb-4">🧥</view>
    <text class="text-xl font-bold text-stone-900 mb-2">衣橱是空的</text>
    <text class="text-stone-500 mb-6">开始添加您的第一件衣物吧</text>
    <button class="bg-blue-600 text-white px-8 py-4 rounded-full text-sm font-bold" bindtap="onOpenCamera">
      拍摄衣物
    </button>
  </view>

  <view wx:else class="grid grid-cols-2 gap-4 pb-24">
    <view 
      wx:for="{{filteredItems}}" 
      wx:key="id"
      class="group relative cursor-pointer"
      bindtap="onViewItem"
      data-item="{{item}}"
    >
      <view class="relative aspect-3-4 rounded-2xl overflow-hidden bg-stone-100 mb-3">
        <image class="w-full h-full object-cover transition-transform group-hover:scale-105" src="{{item.imageUrl}}" mode="aspectFill"></image>
        <view class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
          <view class="opacity-0 group-hover:opacity-100 transition-opacity bg-white p-3 rounded-full shadow-lg">
            <text class="text-xl">👁️</text>
          </view>
        </view>
        <button class="absolute top-2-5 right-2-5 w-8 h-8 bg-white/80 backdrop-blur rounded-full flex items-center justify-center shadow-sm" catchtap="onToggleFavorite" data-id="{{item.id}}">
          <text class="text-lg">{{item.isFavorite ? '❤️' : '🤍'}}</text>
        </button>
      </view>
      <view class="flex items-start justify-between">
        <view>
          <text class="text-sm font-bold text-stone-900 block">{{item.brand || item.category}}</text>
          <text class="text-xs text-stone-500">{{item.category}}</text>
        </view>
        <view class="shrink-0 px-2 py-1 rounded-full text-xs font-medium {{getSeasonBg(item.season)}} {{getSeasonText(item.season)}}">
          {{item.season}}
        </view>
      </view>
    </view>
  </view>

  <view class="fixed bottom-24 left-1/2 transform -translate-x-1/2 z-10">
    <button class="bg-stone-900 text-white px-8 py-4 rounded-full shadow-2xl flex items-center gap-3 animate-bounce" bindtap="onOpenCamera">
      <text class="text-xl">📷</text>
      <text class="text-sm font-bold tracking-wide">添加衣物</text>
    </button>
  </view>

  <view wx:if="{{selectedItem}}" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/60" bindtap="onCloseItem">
    <view class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl overflow-hidden animate-fadeIn" catchtap="">
      <view class="relative aspect-square bg-stone-100">
        <image class="w-full h-full object-cover" src="{{selectedItem.imageUrl}}" mode="aspectFill"></image>
        <button class="absolute top-4 right-4 w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm" bindtap="onCloseItem">
          <text class="text-xl">✕</text>
        </button>
      </view>
      <view class="p-6">
        <view class="flex justify-between items-start mb-6">
          <view>
            <text class="text-sm text-stone-500 uppercase tracking-widest font-bold">{{selectedItem.category}}</text>
            <text class="text-2xl text-serif font-bold text-stone-900 mt-1">{{selectedItem.brand || '未知品牌'}}</text>
          </view>
          <button class="p-2" bindtap="onToggleFavorite" data-id="{{selectedItem.id}}">
            <text class="text-2xl">{{selectedItem.isFavorite ? '❤️' : '🤍'}}</text>
          </button>
        </view>
        
        <view class="flex flex-wrap gap-2 mb-6">
          <view class="px-3 py-1 rounded-full text-xs font-bold {{getColorBg(selectedItem.color)}}">{{selectedItem.color}}</view>
          <view class="px-3 py-1 rounded-full text-xs font-bold bg-stone-100 text-stone-600">{{selectedItem.season}}</view>
          <view wx:if="{{selectedItem.material}}" class="px-3 py-1 rounded-full text-xs font-bold bg-stone-100 text-stone-600">{{selectedItem.material}}</view>
        </view>

        <view wx:if="{{selectedItem.notes}}" class="mb-6 p-4 bg-stone-50 rounded-xl">
          <text class="text-sm text-stone-600">{{selectedItem.notes}}</text>
        </view>

        <view class="flex gap-3">
          <button class="flex-1 py-4 border border-stone-200 rounded-full text-sm font-bold" bindtap="onDeleteItem" data-id="{{selectedItem.id}}">
            删除
          </button>
          <button class="flex-1 py-4 bg-stone-900 text-white rounded-full text-sm font-bold" bindtap="onEditItem" data-item="{{selectedItem}}">
            编辑
          </button>
        </view>
      </view>
    </view>
  </view>
</view>
