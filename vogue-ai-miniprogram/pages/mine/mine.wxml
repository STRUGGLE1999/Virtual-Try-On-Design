<view class="container animate-fadeIn">
  <view class="card mb-6">
    <view class="flex items-center gap-6 mb-6">
      <view class="w-24 h-24 bg-stone-200 rounded-full flex items-center justify-center text-4xl">
        👤
      </view>
      <view class="flex-1">
        <text class="text-2xl font-bold text-stone-900 block">{{userProfile?.name || '时尚达人'}}</text>
        <text class="text-stone-500 mt-1 block">时尚穿搭爱好者</text>
      </view>
    </view>

    <view class="grid grid-cols-3 gap-4 text-center">
      <view>
        <text class="text-2xl font-black text-stone-900 block">{{wardrobeCount}}</text>
        <text class="text-sm text-stone-500 block mt-1">件衣物</text>
      </view>
      <view>
        <text class="text-2xl font-black text-stone-900 block">{{outfitCount}}</text>
        <text class="text-sm text-stone-500 block mt-1">套搭配</text>
      </view>
      <view>
        <text class="text-2xl font-black text-blue-600 block">{{streak}}</text>
        <text class="text-sm text-blue-600 block mt-1">天连续</text>
      </view>
    </view>
  </view>

  <view class="space-y-3 mb-8">
    <view class="flex items-center justify-between p-5 bg-white rounded-2xl active:bg-stone-50 transition-colors">
      <view class="flex items-center gap-4">
        <view class="w-10 h-10 bg-stone-100 rounded-full flex items-center justify-center text-xl">👔</view>
        <text class="font-medium text-stone-900">我的衣橱</text>
      </view>
      <text class="text-stone-400">→</text>
    </view>

    <view class="flex items-center justify-between p-5 bg-white rounded-2xl active:bg-stone-50 transition-colors">
      <view class="flex items-center gap-4">
        <view class="w-10 h-10 bg-stone-100 rounded-full flex items-center justify-center text-xl">⚙️</view>
        <text class="font-medium text-stone-900">设置</text>
      </view>
      <text class="text-stone-400">→</text>
    </view>

    <view class="flex items-center justify-between p-5 bg-white rounded-2xl active:bg-stone-50 transition-colors">
      <view class="flex items-center gap-4">
        <view class="w-10 h-10 bg-stone-100 rounded-full flex items-center justify-center text-xl">❓</view>
        <text class="font-medium text-stone-900">帮助与反馈</text>
      </view>
      <text class="text-stone-400">→</text>
    </view>
  </view>

  <view class="text-center">
    <text class="text-xs text-stone-400">vogue-ai v1.0.0</text>
  </view>
</view>
