<view class="container animate-fadeIn">
  <view class="flex justify-between items-center mb-6">
    <view>
      <text class="text-xs uppercase font-bold tracking-widest text-stone-400">魔法衣橱</text>
      <text class="text-2xl text-serif font-bold text-stone-900 mt-1">智能搭配</text>
    </view>
  </view>

  <view wx:if="{{wardrobeItems.length < 3}}" class="bg-blue-50 border border-blue-100 p-6 rounded-2xl mb-6">
    <view class="flex items-start gap-4">
      <view class="text-4xl">👗</view>
      <view>
        <text class="font-bold text-blue-900 text-lg block">衣橱衣物不足</text>
        <text class="text-blue-700 text-sm mt-1 block">至少需要 3 件衣物才能开始搭配（上装、下装、鞋履）</text>
        <button class="mt-4 bg-blue-600 text-white px-6 py-3 rounded-full text-xs font-bold" bindtap="onOpenCamera">
          去添加
        </button>
      </view>
    </view>
  </view>

  <view wx:else>
    <view class="card">
      <view class="flex justify-between items-center mb-6">
        <view>
          <text class="text-xs uppercase font-bold tracking-widest text-stone-400">今日心情</text>
          <text class="text-lg font-bold text-stone-900">选择风格</text>
        </view>
      </view>
      <view class="grid grid-cols-2 gap-3">
        <view 
          wx:for="{{styles}}" 
          wx:key="id"
          class="p-5 rounded-2xl border-2 transition-all cursor-pointer {{selectedStyle === item.id ? 'border-stone-900 bg-stone-50' : 'border-transparent bg-white hover:border-stone-200'}}"
          bindtap="onSelectStyle"
          data-id="{{item.id}}"
        >
          <text class="text-2xl mb-2 block">{{item.icon}}</text>
          <text class="font-bold text-stone-900 block">{{item.name}}</text>
          <text class="text-xs text-stone-500 mt-1 block">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="card mt-4">
      <view class="flex justify-between items-center mb-6">
        <view>
          <text class="text-xs uppercase font-bold tracking-widest text-stone-400">AI 推荐</text>
          <text class="text-lg font-bold text-stone-900">完美组合</text>
        </view>
        <button class="flex items-center gap-2 px-4 py-2 bg-stone-100 rounded-full" bindtap="onRegenerate">
          <text class="text-base">🎲</text>
          <text class="text-xs font-bold text-stone-700">重新生成</text>
        </button>
      </view>

      <view wx:if="{{generatedOutfit}}" class="relative">
        <view class="grid gap-3">
          <view wx:if="{{generatedOutfit.top}}" class="relative flex items-center gap-4 p-4 bg-stone-50 rounded-2xl border border-stone-100">
            <view class="w-16 h-20 rounded-xl overflow-hidden bg-white">
              <image class="w-full h-full object-cover" src="{{generatedOutfit.top.imageUrl}}" mode="aspectFill"></image>
            </view>
            <view class="flex-1">
              <text class="text-xs text-stone-400 uppercase tracking-widest font-bold">上装</text>
              <text class="font-bold text-stone-900 block">{{generatedOutfit.top.brand || generatedOutfit.top.category}}</text>
            </view>
            <button class="p-2 hover:bg-stone-200 rounded-full transition-colors" bindtap="onReplaceItem" data-slot="top">
              <text class="text-lg">🔄</text>
            </button>
          </view>

          <view class="flex justify-center my-1">
            <text class="text-stone-300 text-xl">+</text>
          </view>

          <view wx:if="{{generatedOutfit.bottom}}" class="relative flex items-center gap-4 p-4 bg-stone-50 rounded-2xl border border-stone-100">
            <view class="w-16 h-20 rounded-xl overflow-hidden bg-white">
              <image class="w-full h-full object-cover" src="{{generatedOutfit.bottom.imageUrl}}" mode="aspectFill"></image>
            </view>
            <view class="flex-1">
              <text class="text-xs text-stone-400 uppercase tracking-widest font-bold">下装</text>
              <text class="font-bold text-stone-900 block">{{generatedOutfit.bottom.brand || generatedOutfit.bottom.category}}</text>
            </view>
            <button class="p-2 hover:bg-stone-200 rounded-full transition-colors" bindtap="onReplaceItem" data-slot="bottom">
              <text class="text-lg">🔄</text>
            </button>
          </view>

          <view class="flex justify-center my-1">
            <text class="text-stone-300 text-xl">+</text>
          </view>

          <view wx:if="{{generatedOutfit.shoes}}" class="relative flex items-center gap-4 p-4 bg-stone-50 rounded-2xl border border-stone-100">
            <view class="w-16 h-20 rounded-xl overflow-hidden bg-white">
              <image class="w-full h-full object-cover" src="{{generatedOutfit.shoes.imageUrl}}" mode="aspectFill"></image>
            </view>
            <view class="flex-1">
              <text class="text-xs text-stone-400 uppercase tracking-widest font-bold">鞋履</text>
              <text class="font-bold text-stone-900 block">{{generatedOutfit.shoes.brand || generatedOutfit.shoes.category}}</text>
            </view>
            <button class="p-2 hover:bg-stone-200 rounded-full transition-colors" bindtap="onReplaceItem" data-slot="shoes">
              <text class="text-lg">🔄</text>
            </button>
          </view>
        </view>

        <view class="mt-8">
          <button class="w-full bg-stone-900 text-white py-5 rounded-full text-sm font-bold shadow-xl animate-glow" bindtap="onSaveOutfit">
            保存这套搭配
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="card mt-4">
    <view class="flex justify-between items-center mb-4">
      <text class="text-xs uppercase font-bold tracking-widest text-stone-400">历史记录</text>
      <text wx:if="{{savedOutfits.length > 0}}" class="text-xs font-bold text-blue-600" bindtap="onViewAllOutfits">查看全部 &rarr;</text>
    </view>
    
    <view wx:if="{{savedOutfits.length === 0}}" class="text-center py-10 text-stone-400">
      <text>还没有保存的搭配</text>
    </view>
    
    <view wx:else class="space-y-4">
      <view wx:for="{{savedOutfits.slice(0, 2)}}" wx:key="id" class="flex items-center gap-4 p-4 bg-stone-50 rounded-xl">
        <view class="flex gap-1">
          <view wx:for="{{item.items}}" wx:for-item="subItem" wx:key="id" class="w-12 h-16 rounded-md overflow-hidden bg-white flex-shrink-0">
            <image class="w-full h-full object-cover" src="{{subItem.imageUrl}}" mode="aspectFill"></image>
          </view>
        </view>
        <view class="flex-1 min-w-0">
          <text class="font-bold text-stone-900 text-sm block">{{item.style}}</text>
          <text class="text-xs text-stone-500 block">{{item.date}}</text>
        </view>
        <button class="p-2">
          <text class="text-lg">❤️</text>
        </button>
      </view>
    </view>
  </view>
</view>
