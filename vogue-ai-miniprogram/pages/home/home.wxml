<view class="container animate-fadeIn">
  <!-- Header -->
  <view class="flex justify-between items-center mb-6">
    <view>
      <text class="text-xs uppercase font-bold tracking-widest text-stone-400">您好</text>
      <text class="text-2xl text-serif font-bold text-stone-900 mt-1">{{userName}}</text>
    </view>
    <view class="relative">
      <button class="w-10 h-10 bg-white border border-stone-200 rounded-full flex items-center justify-center" open-type="getUserInfo" bindgetuserinfo="onGetUserInfo">
        <text class="text-lg">👤</text>
      </button>
      <view wx:if="{{pendingQueueCount > 0}}" class="absolute -top-1 -right-1 w-5 h-5 bg-rose-500 text-white text-xs flex items-center justify-center rounded-full">
        {{pendingQueueCount}}
      </view>
    </view>
  </view>

  <!-- Today's Pick -->
  <view class="card hero-section">
    <view class="flex justify-between items-center mb-4">
      <view>
        <text class="text-xs uppercase font-bold tracking-widest text-stone-400">今日推荐</text>
        <text class="text-2xl text-serif font-bold text-stone-900 mt-1">智能搭配</text>
      </view>
      <button class="flex items-center gap-2 px-4 py-2 bg-white border border-stone-200 rounded-full" bindtap="onRefreshOutfit">
        <text style="font-size: 14px;">🔄</text>
        <text class="text-xs font-bold text-stone-700">换一套</text>
      </button>
    </view>

    <view wx:if="{{currentOutfit}}" class="relative overflow-hidden rounded-3xl aspect-4-5 w-full bg-stone-100">
      <view class="grid grid-cols-2 gap-3 p-3 h-full">
        <view class="col-span-1 row-span-2 rounded-2xl overflow-hidden bg-stone-200 relative">
          <image class="w-full h-full object-cover" src="{{currentOutfit.top.imageUrl}}" mode="aspectFill"></image>
          <view class="absolute top-2-5 right-2-5 bg-white/80 backdrop-blur px-3 py-1 rounded-full">
            <text class="text-xs font-bold text-stone-900">上装</text>
          </view>
        </view>
        <view class="col-span-1 rounded-2xl overflow-hidden bg-stone-200 relative">
          <image class="w-full h-full object-cover" src="{{currentOutfit.bottom.imageUrl}}" mode="aspectFill"></image>
          <view class="absolute top-2-5 right-2-5 bg-white/80 backdrop-blur px-3 py-1 rounded-full">
            <text class="text-xs font-bold text-stone-900">下装</text>
          </view>
        </view>
        <view class="col-span-1 rounded-2xl overflow-hidden bg-stone-200 relative">
          <image class="w-full h-full object-cover" src="{{currentOutfit.shoes.imageUrl}}" mode="aspectFill"></image>
          <view class="absolute top-2-5 right-2-5 bg-white/80 backdrop-blur px-3 py-1 rounded-full">
            <text class="text-xs font-bold text-stone-900">鞋履</text>
          </view>
        </view>
      </view>
      
      <view class="absolute bottom-5 left-5 right-5 glass-card p-4 rounded-2xl flex items-center justify-between">
        <view>
          <text class="text-xs font-bold uppercase tracking-widest text-blue-600">每日风格</text>
          <text class="block text-lg font-bold text-stone-900">{{currentOutfit.style}}</text>
        </view>
        <button class="bg-blue-600 text-white px-6 py-3 rounded-full text-xs font-bold uppercase tracking-wider shadow-lg" bindtap="onSaveOutfit">
          保存
        </button>
      </view>
    </view>
  </view>

  <!-- Quick Actions -->
  <view class="flex gap-4 mb-6">
    <button class="flex-1 flex flex-col items-center justify-center gap-2 py-5 bg-white rounded-2xl border border-stone-200 active:scale-95 transition-all" hover-class="bg-stone-50" bindtap="onOpenCamera">
      <view class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center text-2xl">📷</view>
      <text class="text-xs font-bold text-stone-900">添加衣物</text>
    </button>
    <button class="flex-1 flex flex-col items-center justify-center gap-2 py-5 bg-white rounded-2xl border border-stone-200 active:scale-95 transition-all" hover-class="bg-stone-50" bindtap="onOpenMatch">
      <view class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center text-2xl">✨</view>
      <text class="text-xs font-bold text-stone-900">AI 搭配</text>
    </button>
  </view>

  <!-- Quick Stats -->
  <view class="card">
    <view class="flex justify-between items-center mb-4">
      <text class="text-xs uppercase font-bold tracking-widest text-stone-400">衣橱状态</text>
      <text class="text-xs font-bold text-blue-600" bindtap="onViewWardrobe">查看全部 &rarr;</text>
    </view>
    <view class="grid grid-cols-3 gap-4">
      <view class="text-center p-4 bg-stone-50 rounded-xl">
        <text class="text-3xl font-black text-stone-900">{{wardrobeCount}}</text>
        <text class="block text-xs font-bold text-stone-500 mt-1">件衣物</text>
      </view>
      <view class="text-center p-4 bg-stone-50 rounded-xl">
        <text class="text-3xl font-black text-stone-900">{{outfitCount}}</text>
        <text class="block text-xs font-bold text-stone-500 mt-1">套搭配</text>
      </view>
      <view class="text-center p-4 bg-blue-50 rounded-xl">
        <text class="text-3xl font-black text-blue-600">{{streak}}</text>
        <text class="block text-xs font-bold text-blue-600 mt-1">天连续</text>
      </view>
    </view>
  </view>

  <!-- Recent Activity -->
  <view wx:if="{{recentItems.length > 0}}" class="card">
    <view class="flex justify-between items-center mb-4">
      <text class="text-xs uppercase font-bold tracking-widest text-stone-400">最近添加</text>
    </view>
    <scroll-view class="flex gap-3 overflow-x-auto scrollbar-hide" scroll-x="true">
      <view wx:for="{{recentItems}}" wx:key="id" class="shrink-0 w-24">
        <view class="w-24 h-32 rounded-xl overflow-hidden bg-stone-200 mb-2">
          <image class="w-full h-full object-cover" src="{{item.imageUrl}}" mode="aspectFill"></image>
        </view>
        <text class="text-xs font-bold text-stone-700 truncate block">{{item.category}}</text>
      </view>
    </scroll-view>
  </view>
</view>
