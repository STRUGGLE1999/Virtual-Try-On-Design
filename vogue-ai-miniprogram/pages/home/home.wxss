.section-top {
  margin-bottom: 32px;
}

.hero-section {
  margin-bottom: 32px;
  animation: fadeIn 0.7s ease;
}

.hero-card {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 133.33%;
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  background: #fafaf9;
}

.hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20px;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.1) 50%, transparent 100%);
}

.quick-entry-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-bottom: 32px;
}

.quick-entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px;
  border-radius: 16px;
  background: #fafaf9;
  border: 1px solid rgba(0, 0, 0, 0.05);
  text-align: center;
  transition: all 0.3s ease;
}

.quick-entry-item:active {
  transform: scale(0.98);
}

.quick-entry-blue {
  background: #eff6ff;
  border-color: rgba(99, 102, 241, 0.1);
}

.quick-entry-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 1px solid #e7e5e4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  background: white;
}

.quick-entry-icon-blue {
  border-color: rgba(99, 102, 241, 0.2);
  background: white;
}

.section-space {
  margin-bottom: 32px;
}

.favorites-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.favorite-item {
  cursor: pointer;
}

.favorite-image-wrap {
  width: 100%;
  aspect-ratio: 4/5;
  border-radius: 16px;
  overflow: hidden;
  background: #f5f5f4;
  margin-bottom: 8px;
  border: 1px solid rgba(0, 0, 0, 0.05);
}

.favorite-image {
  width: 100%;
  height: 100%;
  transition: transform 0.5s ease;
}

.favorite-item:active .favorite-image {
  transform: scale(1.05);
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 16px;
}

.modal-content {
  background: white;
  width: 100%;
  max-width: 400px;
  padding: 24px;
  border-radius: 24px;
  border: 1px solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25);
}

.modal-sm {
  max-width: 320px;
}

.upload-area {
  border: 2px dashed #e7e5e4;
  border-radius: 24px;
  padding: 32px;
  text-align: center;
  transition: all 0.3s ease;
}

.upload-area-active {
  border-color: #0041c9;
  background: rgba(239, 246, 255, 0.5);
}

.loading-spinner {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 4px solid #f5f5f4;
  border-top-color: #f43f5e;
  border-right-color: #6366f1;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

