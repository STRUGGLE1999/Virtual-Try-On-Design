<view class="container animate-fadeIn">
  <view class="flex justify-between items-center mb-6">
    <view>
      <text class="text-xs uppercase font-bold tracking-widest text-stone-400">我的日历</text>
      <text class="text-2xl text-serif font-bold text-stone-900 mt-1">穿搭日记</text>
    </view>
  </view>

  <view class="card p-6">
    <view class="flex justify-between items-center mb-6">
      <button class="p-2 hover:bg-stone-100 rounded-full" bindtap="onPrevMonth">
        <text class="text-xl">←</text>
      </button>
      <text class="text-lg font-bold text-stone-900">{{currentMonthLabel}}</text>
      <button class="p-2 hover:bg-stone-100 rounded-full" bindtap="onNextMonth">
        <text class="text-xl">→</text>
      </button>
    </view>

    <view class="grid grid-cols-7 gap-1 mb-2">
      <view wx:for="{{weekdays}}" wx:key="*this" class="text-center text-xs font-bold text-stone-400 py-2">
        {{item}}
      </view>
    </view>

    <view class="grid grid-cols-7 gap-1">
      <view 
        wx:for="{{calendarDays}}" 
        wx:key="date"
        class="aspect-square flex flex-col items-center justify-center rounded-xl cursor-pointer transition-all relative {{item.isToday ? 'bg-blue-600 text-white' : ''}} {{item.hasOutfit ? 'ring-2 ring-blue-600 ring-offset-1' : ''}} {{!item.currentMonth ? 'text-stone-300' : ''}} {{item.isSelected ? 'bg-stone-100' : ''}}"
        bindtap="onSelectDate"
        data-date="{{item.date}}"
      >
        <text class="text-sm font-medium">{{item.day}}</text>
        <view wx:if="{{item.hasOutfit}}" class="w-2 h-2 rounded-full mt-1 {{item.isToday ? 'bg-white' : 'bg-blue-600'}}"></view>
      </view>
    </view>
  </view>

  <view class="card mt-4">
    <view class="flex justify-between items-center mb-4">
      <text class="text-xs uppercase font-bold tracking-widest text-stone-400">
        {{selectedDateLabel}}
      </text>
    </view>

    <view wx:if="{{selectedOutfit}}">
      <view class="flex items-center gap-4 mb-6">
        <view class="flex gap-2">
          <view wx:for="{{selectedOutfit.items}}" wx:key="id" class="w-20 h-28 rounded-xl overflow-hidden bg-stone-100">
            <image class="w-full h-full object-cover" src="{{item.imageUrl}}" mode="aspectFill"></image>
          </view>
        </view>
        <view class="flex-1">
          <text class="text-sm text-stone-500 uppercase tracking-widest font-bold block">今日穿搭</text>
          <text class="text-lg font-bold text-stone-900 block">{{selectedOutfit.style}}</text>
        </view>
      </view>
      <view class="flex gap-3">
        <button class="flex-1 py-3 border border-stone-200 rounded-full text-sm font-bold" bindtap="onRemoveOutfit">
          移除
        </button>
      </view>
    </view>

    <view wx:else>
      <view class="flex flex-col items-center justify-center py-10 text-center">
        <text class="text-4xl mb-4">📅</text>
        <text class="text-stone-500 mb-4">这一天还没有记录穿搭</text>
        <button wx:if="{{app.globalData.savedOutfits && app.globalData.savedOutfits.length > 0}}" class="bg-stone-900 text-white px-6 py-3 rounded-full text-sm font-bold" bindtap="onAddOutfit">
          从保存的搭配中选择
        </button>
      </view>
    </view>
  </view>

  <view class="card mt-4">
    <view class="flex justify-between items-center mb-4">
      <text class="text-xs uppercase font-bold tracking-widest text-stone-400">本月统计</text>
    </view>
    <view class="grid grid-cols-3 gap-4">
      <view class="text-center">
        <text class="text-3xl font-black text-stone-900">{{stats.totalDays}}</text>
        <text class="text-xs font-bold text-stone-500 block mt-1">总天数</text>
      </view>
      <view class="text-center">
        <text class="text-3xl font-black text-blue-600">{{stats.recordedDays}}</text>
        <text class="text-xs font-bold text-blue-600 block mt-1">已记录</text>
      </view>
      <view class="text-center">
        <text class="text-3xl font-black text-emerald-600">{{stats.streak}}</text>
        <text class="text-xs font-bold text-emerald-600 block mt-1">连续天数</text>
      </view>
    </view>
  </view>
</view>
