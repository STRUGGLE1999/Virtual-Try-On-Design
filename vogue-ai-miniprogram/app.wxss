page {
  background-color: #f8f9fa;
  color: #191c1d;
  font-family: -apple-system, BlinkMacSystemFont, "Hanken Grotesk", "Segoe UI", Roboto, sans-serif;
  font-size: 16px;
  line-height: 1.5;
}

.container {
  padding: 20px;
  padding-bottom: 100px;
  min-height: 100vh;
}

