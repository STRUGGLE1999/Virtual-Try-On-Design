/* pages/calendar/calendar.wxss */
.month-label {
  background-color: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
}

.calendar-card {
  padding: 24rpx;
}

.weekdays-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  margin-bottom: 20rpx;
}

.weekday-cell {
  font-size: 24rpx;
  color: #868e96;
  font-weight: bold;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 16rpx;
}

.day-cell {
  position: relative;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.day-cell.empty {
  visibility: hidden;
}

.day-cell.active {
  background-color: #1a1a1a;
  color: #ffffff;
  font-weight: bold;
}

.day-cell.has-log {
  background-color: #f1f3f5;
  color: #1a1a1a;
}

.day-cell.has-log.active {
  background-color: #1a1a1a;
  color: #ffffff;
}

.log-indicator {
  position: absolute;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #3b82f6;
}

.day-cell.active .log-indicator {
  background-color: #ffffff;
}

.section-title {
  margin-top: 15rpx;
}

.log-card {
  padding: 30rpx;
}

.star-icon {
  font-size: 26rpx;
  margin-left: 2rpx;
}

.items-row {
  gap: 16rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.item-pic-card {
  display: inline-block;
  width: 140rpx;
  margin-right: 16rpx;
  text-align: center;
}

.item-pic-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f8f9fa;
  border: 1rpx solid rgba(0,0,0,0.03);
  margin-bottom: 8rpx;
}

.item-pic-title {
  color: #495057;
}

.item-pic-add {
  display: inline-block;
  vertical-align: top;
  width: 120rpx;
  height: 120rpx;
  border: 2rpx dashed #ced4da;
  border-radius: 12rpx;
  padding-top: 22rpx;
}

.add-symbol {
  font-size: 34rpx;
  line-height: 1;
  color: #adb5bd;
}

.border-top {
  border-top: 1rpx solid #f1f3f5;
}

.pt-20 {
  padding-top: 20rpx;
}

.btn-micro {
  background-color: #e9ecef;
  font-size: 22rpx;
  color: #1a1a1a;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.3;
}

.no-log-card {
  padding: 50rpx 30rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.inline-block {
  display: inline-block;
}

.m-b-10 { margin-bottom: 10rpx; }
.m-b-20 { margin-bottom: 20rpx; }
