/* pages/home/home.wxss */
.weather-bar {
  margin-top: 10rpx;
  margin-bottom: 30rpx;
}

.tag-label {
  background-color: #f1f3f5;
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  color: #1a1a1a;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.filter-row {
  margin-bottom: 35rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 36rpx;
  background-color: #ffffff;
  color: #495057;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 100rpx;
  margin-right: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.filter-item.active {
  background-color: #1a1a1a;
  color: #ffffff;
  font-weight: bold;
}

.recommend-card {
  padding: 0;
  overflow: hidden;
  border-radius: 32rpx;
}

.image-wrapper {
  position: relative;
  width: 100%;
  height: 480rpx;
  background-color: #e9ecef;
}

.outfit-image {
  width: 100%;
  height: 100%;
}

.temp-badge {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background-color: rgba(255, 255, 255, 0.95);
  font-size: 22rpx;
  font-weight: bold;
  color: #1a1a1a;
  padding: 8rpx 18rpx;
  border-radius: 100rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.recommend-info {
  padding: 30rpx;
}

.outfit-name {
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.fav-icon {
  font-size: 24rpx;
  color: #e03131;
  font-weight: bold;
}

.outfit-desc {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 30rpx;
  line-height: 1.6;
}

.recommend-actions {
  gap: 16rpx;
}

.btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 16rpx;
  font-weight: bold;
  padding: 20rpx 0;
  line-height: 1.2;
  text-align: center;
}

.btn-primary {
  background-color: #3b82f6;
  color: #ffffff;
}

.btn-secondary {
  background-color: #f1f3f5;
  color: #1a1a1a;
  border: 1rpx solid rgba(0,0,0,0.02);
}

.section-title {
  display: block;
  margin-top: 15rpx;
  margin-bottom: 20rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.grid-item {
  background-color: #ffffff;
  padding: 30rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
}

.grid-icon {
  font-size: 44rpx;
  margin-bottom: 15rpx;
}

.grid-title {
  color: #333333;
  margin-bottom: 6rpx;
}

.grid-desc {
  color: #868e96;
}
