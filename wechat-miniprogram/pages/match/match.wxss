/* pages/match/match.wxss */
.stats-row {
  gap: 16rpx;
  margin-bottom: 25rpx;
}

.stat-box {
  flex: 1;
  text-align: center;
  padding: 20rpx 10rpx;
  margin-bottom: 0px;
}

.stat-val {
  font-size: 38rpx;
  color: #1a1a1a;
  display: block;
  margin-bottom: 4rpx;
}

.stat-name {
  white-space: nowrap;
}

.slots-layout {
  width: 100%;
  margin-bottom: 30rpx;
}

.slots-inner {
  align-items: flex-start;
  gap: 20rpx;
}

.left-side {
  flex: 1.1;
  height: 520rpx;
  margin-bottom: 0px;
}

.right-side {
  flex: 1;
  height: 520rpx;
  display: flex;
  flex-direction: column;
}

.right-side .slot-container {
  flex: 1;
  margin-bottom: 0px;
}

.slot-container {
  padding: 0rpx;
  overflow: hidden;
  position: relative;
  background-color: #ededed;
  border-radius: 28rpx;
  transition: all 0.25s ease;
}

.slot-container.active {
  border: 4rpx solid #3b82f6;
  box-shadow: 0 4rpx 18rpx rgba(59, 130, 246, 0.25);
}

.slot-image {
  width: 100%;
  height: 100%;
}

.slot-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.65), rgba(0,0,0,0) 60%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 16rpx;
}

.slot-badge {
  background-color: rgba(255, 255, 255, 0.9);
  color: #1a1a1a;
  font-size: 16rpx;
  font-weight: bold;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  align-self: flex-start;
  margin-bottom: 8rpx;
}

.slot-title {
  color: #ffffff;
  font-weight: bold;
}

.border-bottom {
  border-bottom: 1rpx solid #f1f3f5;
  padding-bottom: 15rpx;
}

.option-pool-box {
  background-color: #ffffff;
}

.option-scroll {
  display: flex;
  flex-direction: row;
  height: 200rpx;
  white-space: nowrap;
}

.opt-card {
  display: inline-block;
  width: 150rpx;
  margin-right: 20rpx;
  text-align: center;
}

.opt-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background-color: #f1f1f1;
  margin-bottom: 10rpx;
  border: 1rpx solid rgba(0,0,0,0.02);
}

.opt-title {
  color: #333333;
}

.full-width {
  width: 100%;
}

.m-b-20 {
  margin-bottom: 20rpx;
}

.m-t-30 {
  margin-top: 30rpx;
}
