/* pages/wardrobe/wardrobe.wxss */
.header-row {
  margin-top: 10rpx;
  margin-bottom: 25rpx;
}

.count-tag {
  background-color: #f1f3f5;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.add-btn {
  background-color: #1a1a1a;
  color: #ffffff;
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  gap: 8rpx;
}

.add-icon {
  font-size: 32rpx;
  line-height: 1;
}

.search-box {
  width: 100%;
}

.search-input {
  background-color: #ffffff;
  padding: 18rpx 30rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.ai-scanning-section {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 35rpx;
  border: 1rpx solid rgba(79, 70, 229, 0.08); /* Indigo border */
}

.pending-scroll {
  display: flex;
  flex-direction: row;
  height: 160rpx;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.pending-card {
  display: inline-block;
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 16rpx;
  position: relative;
  border: 2rpx solid transparent;
}

.pending-card.active {
  border-color: #4f46e5;
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.15);
}

.pending-thumbnail {
  width: 100%;
  height: 100%;
}

.confirm-overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(79, 70, 229, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-tick {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
}

.scan-meta-card {
  margin-bottom: 0px;
  background-color: #fafbfc;
  box-shadow: none;
  padding: 24rpx;
}

.scan-percent {
  background-color: rgba(79, 70, 229, 0.06);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.scan-name {
  color: #1a1a1a;
}

.scan-grids {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.scan-factor {
  flex: 1;
  background-color: #ffffff;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0,0,0,0.02);
}

.filter-row {
  margin-bottom: 30rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 36rpx;
  background-color: #ffffff;
  color: #495057;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 100rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.filter-item.active {
  background-color: #1a1a1a;
  color: #ffffff;
  font-weight: bold;
}

.clothing-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.clothing-item {
  padding: 0rpx;
  overflow: hidden;
  border-radius: 28rpx;
  margin-bottom: 0px;
}

.clothing-thumb {
  width: 100%;
  height: 280rpx;
  background-color: #e9ecef;
}

.clothing-info {
  padding: 20rpx;
}

.brand-sub {
  margin-bottom: 4rpx;
}

.item-title {
  color: #212529;
  font-size: 26rpx;
  margin-bottom: 15rpx;
}

.tag-row {
  margin-bottom: 15rpx;
  white-space: nowrap;
  overflow: hidden;
}

.color-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(0,0,0,0.1);
}

.full-width {
  width: 100%;
}

.m-t-20 {
  margin-top: 20rpx;
}
